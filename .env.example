# ─── Client (safe to expose; still never commit real values) ───────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Server only (must never reach a client bundle) ────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=

# ─── Providers (server only; use sandbox/test values locally) ──────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
OPENAI_API_KEY=
POSTHOG_API_KEY=

# ─── Local adapters ─────────────────────────────────────────────────────────
# Set to "mock" to use local mock identity/moderation adapters (never in prod)
IDENTITY_PROVIDER=mock
MODERATION_PROVIDER=mock
EXPO_PUBLIC_WEB_ORIGIN=

# ─── Build/deploy (not secret) ──────────────────────────────────────────────
# EAS project id — app.config.ts already defaults to the linked project;
# set only to override.
EAS_PROJECT_ID=

# Video ingest worker (Phase 3a). The secret gates /api/media/ingest-run
# (>=16 chars, timing-safe compared); the byte cap is the server authority the
# clients mirror — 52428800 (50MB) while the Supabase plan is Free, raise to
# 209715200 after the Pro upgrade.
FRIENDWORD_MEDIA_INGEST_SECRET=
FRIENDWORD_VIDEO_MAX_BYTES=52428800
