{
  "name": "@friendword/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "test:audit": "pnpm --filter @friendword/contracts exec vitest run --config ../../apps/web/vitest.audit.config.ts",
    "test:audit2": "pnpm --filter @friendword/contracts exec vitest run --config ../../apps/web/vitest.audit2.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@friendword/adapters": "workspace:*",
    "@friendword/contracts": "workspace:*",
    "@friendword/data": "workspace:*",
    "@friendword/domain": "workspace:*",
    "@friendword/ui-tokens": "workspace:*",
    "@supabase/supabase-js": "^2.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
