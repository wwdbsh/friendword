{
  "name": "friendword",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:env": "node scripts/check-env.mjs",
    "test:db": "bash scripts/test-db.sh",
    "test:audit": "bash scripts/test-db-audit.sh && pnpm --filter @friendword/web test:audit",
    "test:audit2": "bash scripts/test-db-audit2.sh && pnpm --filter @friendword/web test:audit2",
    "test:audit3": "bash scripts/test-db-audit3.sh && pnpm --filter @friendword/web test:audit3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
